# Copy to `.env` and fill in. Everything here ships inside the app bundle and is
# public by design — no secrets. The FCM service account lives only in Cloud
# Functions, never here.

# --- Cloudinary (Settings > Upload > Upload presets > add, mode: Unsigned) ---
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=flyer_unsigned

# --- Google Sign-In (Firebase console > Authentication > Google) ---
# Web client ID is the one Firebase auto-creates; it is what RNFirebase needs to
# exchange the Google idToken for a Firebase credential.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-yyyyyyyy.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.000000000000-yyyyyyyy

# --- Firebase Realtime Database ---
EXPO_PUBLIC_RTDB_URL=https://your-project-default-rtdb.firebaseio.com

# --- Native Google service files (paths, or EAS file-type secrets) ---
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist

# --- EAS ---
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
